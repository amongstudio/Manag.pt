SITE_ADDRESS=localhost
ACME_EMAIL=admin@example.com
# Production (Docker NODE_ENV=production) refuses change-me-* and secrets shorter than 16 chars.
ENROLLMENT_SECRET=replace-with-a-long-random-secret
PUBLIC_URL=http://localhost
CORS_ORIGIN=http://localhost
UPDATE_SIGNING_SECRET=replace-with-a-long-random-secret
# Optional. If set, required on /api/v1/admin/* and Socket.io handshake unless a SQLite operator session is present.
# Production should set this even with dashboard login.
OPERATOR_TOKEN=
DEVICE_KEY_PEPPER=
IP_ALLOWLIST=
TRUST_PROXY=1
TURN_URL=
TURN_SECRET=
