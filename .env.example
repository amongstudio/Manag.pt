# Copy to .env for local development. Do not commit secrets.

# API
PORT=4000
HOST=::
# Leave DATA_DIR unset to use <repo>/data when the API runs from apps/api
DATABASE_URL=file:../../data/pcmanager.db
ENROLLMENT_SECRET=change-me-enrollment-secret
PUBLIC_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
UPDATE_SIGNING_SECRET=dev-update-secret
# Also used as HKDF input for the device credential vault (AES-256-GCM) when CREDENTIALS_KEY is unset.
# Changing either value makes existing vault rows undecryptable.
# CREDENTIALS_KEY=

# Optional. If set, required on /api/v1/admin/* and Socket.io handshake unless a SQLite operator session is present.
# Use the same value as NEXT_PUBLIC_OPERATOR_TOKEN for the dashboard. Production should set this even with dashboard login.
OPERATOR_TOKEN=
# Optional dedicated pepper for device-key HMAC. Falls back to UPDATE_SIGNING_SECRET.
DEVICE_KEY_PEPPER=
# Optional mesh CA (PEM cert+key, or a file path). Unset derives an ECDSA P-256 CA from UPDATE_SIGNING_SECRET.
MESH_CA=
MESH_CA_KEY=
# TRUST_PROXY=1 means one reverse-proxy hop, not trust-all XFF.
TRUST_PROXY=

# WebRTC TURN (coturn use-auth-secret). Optional.
TURN_URL=
TURN_SECRET=

RATE_LIMIT_PER_MINUTE=120
IP_ALLOWLIST=
# 512 MiB. Omit to use the shared default; a leftover 50MB value will keep the old cap.
MAX_UPLOAD_BYTES=536870912
MAX_SCREENSHOT_BYTES=8388608
# Stamp packs only. Docker compile-in-request stays off unless you implement it.
ENABLE_AGENT_COMPILE=0

# Web
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_OPERATOR_TOKEN=
API_INTERNAL_URL=http://localhost:4000
